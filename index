    function broadcastNextQuestion() {
        if (currentQIndex >= questionsBank.length) {
            finishGame();
            return;
        }

        const q = questionsBank[currentQIndex];
        studentAnswers = {};

        const qPayload = {
            action: 'start_question',
            qIndex: currentQIndex + 1,
            totalQ: questionsBank.length,
            question: {
                type: q.type,
                question: q.question || '',
                japanese: q.japanese || '',
                choiceA: q.choiceA || q.choices?.[0] || '',
                choiceB: q.choiceB || q.choices?.[1] || '',
                choiceC: q.choiceC || q.choices?.[2] || '',
                choiceD: q.choiceD || q.choices?.[3] || '',
                choices: q.choices || [q.choiceA, q.choiceB, q.choiceC, q.choiceD],
                answer: q.answer,
                time: q.time
            }
        };

        teacherConnections.forEach(conn => conn.send(qPayload));

        showTeacherSection('game');
        document.getElementById('currentQNumBadge').innerText = `Q ${currentQIndex + 1} / ${questionsBank.length}`;
        document.getElementById('qTypeBadge').innerText = q.type === 'reorder' ? '並べ替え' : '4択';
        document.getElementById('teacherQuestionText').innerText = q.type === 'reorder' ? q.japanese : q.question;

        timerSeconds = q.time;
        document.getElementById('teacherTimer').innerText = timerSeconds;

        if (questionTimerInterval) clearInterval(questionTimerInterval);
        questionTimerInterval = setInterval(() => {
            timerSeconds--;
            document.getElementById('teacherTimer').innerText = timerSeconds;
            if (timerSeconds <= 0) {
                clearInterval(questionTimerInterval);
                soundSystem.play('timeup');
                soundSystem.stopBgm();
                evaluateAndRevealAnswers();
            } else if (timerSeconds <= 10) {
                soundSystem.play('countdown');
            }
        }, 1000);

        renderTeacherLiveAnswerDistribution();
        renderTeacherLiveTeamScores();
    }

    function setupStudentQuestionScreen(qData, qIndex, totalQ) {
        timerSeconds = Number(qData.time) || 20;
        document.getElementById('studentTimer').innerText = `${timerSeconds}s`;
        document.getElementById('studentReorderTimer').innerText = `${timerSeconds}s`;

        if (qData.type === 'choice') {
            showStudentSection('choice');
            document.getElementById('studentQNum').innerText = `Q ${qIndex} / ${totalQ}`;
            document.getElementById('studentChoicePrompt').innerText = qData.question;
            
            const choices = qData.choices || [qData.choiceA, qData.choiceB, qData.choiceC, qData.choiceD];
            document.getElementById('choiceText0').innerText = choices[0] || '';
            document.getElementById('choiceText1').innerText = choices[1] || '';
            document.getElementById('choiceText2').innerText = choices[2] || '';
            document.getElementById('choiceText3_d').innerText = choices[3] || '';
        } else if (qData.type === 'reorder') {
            showStudentSection('reorder');
            document.getElementById('studentReorderQNum').innerText = `Q ${qIndex} / ${totalQ}`;
            document.getElementById('reorderJapanesePrompt').innerText = qData.japanese;
            setupImprovedReorderSystem(qData.answer);
        }
    }

    function submitStudentAnswer(choiceIdx) {
        soundSystem.play('click');
        const q = isAssignmentMode ? currentAssignmentData.questions[assignmentCurrentIndex] : questionsBank[currentQIndex];
        const choices = q.choices || [q.choiceA, q.choiceB, q.choiceC, q.choiceD];
        const selectedText = choices[choiceIdx];

        if (isAssignmentMode) {
            const normalize = s => String(s||'').trim().toLowerCase();
            const isCorrect = (normalize(selectedText) === normalize(q.answer)) || (choiceIdx === ['A','B','C','D'].indexOf(q.answer));
            handleAssignmentAnswer(isCorrect, selectedText);
        } else {
            if (studentConnection) {
                studentConnection.send({
                    action: 'submit_answer',
                    choiceIndex: choiceIdx,
                    choiceText: selectedText,
                    remainingTime: timerSeconds
                });
            }
            showStudentSection('submitted');
        }
    }

    function evaluateAndRevealAnswers() {
        soundSystem.stopBgm();
        soundSystem.play('score');
        const q = questionsBank[currentQIndex];

        studentsList.forEach(student => {
            const ans = studentAnswers[student.peerId];
            let isCorrect = false;
            let earnedPoints = 0;

            if (ans) {
                const normalize = s => String(s||'').replace(/[\/\,\.]/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
                if (q.type === 'choice') {
                    const choices = q.choices || [q.choiceA, q.choiceB, q.choiceC, q.choiceD];
                    isCorrect = (normalize(ans.choiceText) === normalize(q.answer)) || (ans.choiceIndex === ['A','B','C','D'].indexOf(q.answer));
                } else if (q.type === 'reorder') {
                    isCorrect = (normalize(ans.reorderString) === normalize(q.answer));
                }

                if (isCorrect) {
                    student.correctCount++;
                    student.streak++;
                    let base = 1000;
                    let timeBonus = Math.floor((ans.remainingTime / q.time) * 500);
                    let comboBonus = student.streak > 1 ? (student.streak * 100) : 0;
                    earnedPoints = base + timeBonus + comboBonus;
                    student.score += earnedPoints;
                } else {
                    student.incorrectCount++;
                    student.streak = 0;
                }
            } else {
                student.incorrectCount++;
                student.streak = 0;
            }

            const conn = teacherConnections.find(c => c.peer === student.peerId);
            if (conn) {
                conn.send({
                    action: 'reveal_answer',
                    isCorrect: isCorrect,
                    earnedPoints: earnedPoints,
                    totalScore: student.score,
                    streak: student.streak
                });
            }
        });

        showTeacherSection('reveal');
        document.getElementById('teacherCorrectAnswerDisplay').innerText = q.type === 'choice' ? q.answer : q.answer.replace(/\//g, ' ');
        document.getElementById('teacherExplanationText').innerText = q.explanation || '解説は登録されていません。';
    }

    function showLeaderboardScreen() {
        soundSystem.play('leaderboard');
        showTeacherSection('leaderboard');

        const activeTeams = TEAMS.slice(0, activeConfig.teamCount);
        const teamScores = activeTeams.map(t => {
            const members = studentsList.filter(s => s.team === t.id);
            return { ...t, score: members.reduce((sum, s) => sum + s.score, 0) };
        });
        teamScores.sort((a, b) => b.score - a.score);

        document.getElementById('teamLeaderboardList').innerHTML = teamScores.map((t, rank) => `
            <div class="glass-panel p-3.5 rounded-xl flex justify-between items-center border-l-4 border-${t.id.toLowerCase()}-500">
                <span class="font-bold text-white text-sm">${rank + 1}. ${t.name}</span>
                <span class="font-mono font-bold text-amber-400">${t.score.toLocaleString()} pts</span>
            </div>
        `).join('');

        const sortedStudents = [...studentsList].sort((a, b) => b.score - a.score).slice(0, 5);
        document.getElementById('studentLeaderboardList').innerHTML = sortedStudents.map((s, rank) => `
            <div class="bg-slate-900/60 p-3 rounded-xl flex justify-between items-center border border-slate-800 text-xs">
                <span class="font-bold text-white">${rank + 1}. ${s.nickname} (${s.team})</span>
                <span class="font-mono text-amber-400 font-bold">${s.score.toLocaleString()} pts</span>
            </div>
        `).join('');
    }

    function nextQuestionOrFinish() {
        currentQIndex++;
        if (currentQIndex >= questionsBank.length) finishGame();
        else broadcastNextQuestion();
    }

    function finishGame() {
        soundSystem.stopBgm();
        soundSystem.play('win');
        showTeacherSection('final');

        const activeTeams = TEAMS.slice(0, activeConfig.teamCount);
        const teamScores = activeTeams.map(t => {
            const members = studentsList.filter(s => s.team === t.id);
            return { ...t, score: members.reduce((sum, s) => sum + s.score, 0) };
        });
        teamScores.sort((a, b) => b.score - a.score);

        document.getElementById('winningTeamName').innerText = teamScores[0].name;
        document.getElementById('winningTeamScore').innerText = `${teamScores[0].score.toLocaleString()} pts`;

        teacherConnections.forEach(conn => conn.send({ action: 'game_over' }));
    }

    function renderTeacherLiveAnswerDistribution() {
        const container = document.getElementById('teacherAnswerDistribution');
        if (!container) return;
        const answeredCount = Object.keys(studentAnswers).length;
        container.innerHTML = `
            <div class="col-span-4 glass-panel p-4 rounded-2xl text-center">
                <span class="text-xs font-bold text-slate-400 block">回答提出済み生徒数</span>
                <span class="text-3xl font-black text-emerald-400 mt-1">${answeredCount} / ${studentsList.length} 人</span>
            </div>
        `;
    }

    function renderTeacherLiveTeamScores() {
        const container = document.getElementById('teacherLiveTeamScores');
        if (!container) return;
        const activeTeams = TEAMS.slice(0, activeConfig.teamCount);
        container.innerHTML = activeTeams.map(t => {
            const members = studentsList.filter(s => s.team === t.id);
            const total = members.reduce((sum, s) => sum + s.score, 0);
            return `
                <div class="glass-panel p-3 rounded-xl border-l-4 border-${t.id.toLowerCase()}-500 flex justify-between items-center">
                    <span class="font-bold text-xs text-white">${t.name}</span>
                    <span class="font-mono font-bold text-sm text-amber-400">${total.toLocaleString()} pts</span>
                </div>
            `;
        }).join('');
    }

    function showStudentResultScreen(data) {
        showStudentSection('result');
        const statusBox = document.getElementById('studentResultStatus');

        if (data.isCorrect) {
            soundSystem.play('correct');
            statusBox.innerHTML = `<i class="fa-solid fa-circle-check text-5xl text-emerald-400"></i><h3 class="text-2xl font-black text-emerald-400">CORRECT!</h3>`;
        } else {
            soundSystem.play('incorrect');
            statusBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-5xl text-rose-400"></i><h3 class="text-2xl font-black text-rose-400">TRY AGAIN</h3>`;
        }

        document.getElementById('studentEarnedPoints').innerText = `+${data.earnedPoints.toLocaleString()} pts`;
    }

    function forceFinishQuestion() {
        if (questionTimerInterval) clearInterval(questionTimerInterval);
        evaluateAndRevealAnswers();
    }

    function copyStudentJoinLink() {
        const isWeb = /^https?:$/i.test(window.location.protocol);
        if (!isWeb) {
            alert("Web公開後にリンクを取得できます。");
            return;
        }
        const url = `${window.location.href.split('?')[0]}?student=1&join=${gameCode}`;
        navigator.clipboard.writeText(url).then(() => alert("Google Classroom用リンクをコピーしました！"));
    }

    function downloadResultsCSV() {}

    // --- INITIALIZATION ---
    window.addEventListener('load', () => {
        const isAssign = checkAssignmentUrlAndLoad();
        if (!isAssign) {
            const params = new URLSearchParams(window.location.search);
            if (params.get('student') === '1' || params.get('join')) {
                switchRole('student');
                const code = (params.get('join') || '').replace(/\D/g,'').slice(0,6);
                if (code) document.getElementById('joinGameCode').value = code;
            }
        }
    });
</script>
