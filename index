<style>
    @import url('[https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Zen+Maru+Gothic:wght@500;700;900&display=swap](https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Zen+Maru+Gothic:wght@500;700;900&display=swap)');
    
    body {
        font-family: 'Zen Maru Gothic', 'Plus Jakarta Sans', sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        touch-action: manipulation;
    }

    .team-red { background-color: #ef4444; color: white; }
    .team-blue { background-color: #3b82f6; color: white; }
    .team-green { background-color: #10b981; color: white; }
    .team-yellow { background-color: #f59e0b; color: white; }
    .team-purple { background-color: #8b5cf6; color: white; }

    .btn-choice-0 { background-color: #ef4444; }
    .btn-choice-1 { background-color: #3b82f6; }
    .btn-choice-2 { background-color: #f59e0b; }
    .btn-choice-3 { background-color: #10b981; }

    .word-card {
        transition: all 0.15s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        user-select: none;
        -webkit-user-select: none;
    }
    .word-card:active {
        transform: scale(0.95);
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.85);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    @keyframes pulse-subtle {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.85; transform: scale(0.98); }
    }
    .pulse-anim {
        animation: pulse-subtle 2s infinite ease-in-out;
    }

    /* Shake animation for wrong reorder word tap */
    @keyframes shake-wrong {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }
    .shake-error {
        animation: shake-wrong 0.35s ease-in-out;
        border-color: #ef4444 !important;
        background-color: #7f1d1d !important;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }
    ::-webkit-scrollbar-track {
        background: #1e293b;
    }
    ::-webkit-scrollbar-thumb {
        background: #475569;
        border-radius: 4px;
    }
</style>
<!-- HEADER / NAVBAR -->
<header class="glass-panel sticky top-0 z-50 px-4 py-3 flex justify-between items-center shadow-lg border-b border-slate-700">
    <div class="flex items-center gap-3 cursor-pointer" onclick="handleLogoClick()">
        <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 p-2 rounded-xl text-white shadow-md">
            <i class="fa-solid font-black fa-trophy text-xl"></i>
        </div>
        <div>
            <h1 class="font-extrabold text-xl tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400">
                English Battle
            </h1>
            <p class="text-xs text-slate-400 font-medium">高校英語クラスルーム & 週末課題アプリ</p>
        </div>
    </div>

    <!-- Audio & Sound Controls -->
    <div class="flex items-center gap-2">
        <button id="soundToggleBtn" onclick="toggleSound()" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition border border-slate-700">
            <i id="soundIcon" class="fa-solid fa-volume-high"></i>
        </button>
        <span id="roleBadge" class="hidden text-xs px-2.5 py-1 rounded-full font-bold bg-indigo-900/60 text-indigo-300 border border-indigo-500/30">
            未選択
        </span>
    </div>
</header>

<!-- MAIN CONTAINER -->
<main class="flex-1 max-w-5xl w-full mx-auto p-4 flex flex-col justify-center items-center">

    <!-- ==================== ROLE SELECT SCREEN ==================== -->
    <div id="roleSelectScreen" class="w-full max-w-lg text-center space-y-8 py-8">
        <div class="space-y-3">
            <span class="px-3 py-1 bg-indigo-500/10 text-indigo-400 text-sm font-semibold rounded-full border border-indigo-500/20">
                Interactive English Quiz
            </span>
            <h2 class="text-3xl font-black text-white tracking-tight">どちらで参加しますか？</h2>
            <p class="text-slate-400 text-sm">先生はリアルタイム対戦・課題作成、生徒はゲームまたは課題に参加します。</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <button onclick="switchRole('teacher')" class="group p-6 glass-panel rounded-2xl hover:border-indigo-500 transition duration-300 flex flex-col items-center gap-4 text-center hover:shadow-indigo-500/10 hover:shadow-2xl">
                <div class="w-16 h-16 rounded-2xl bg-indigo-600/20 text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition flex items-center justify-center text-2xl font-bold">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg text-white group-hover:text-indigo-400 transition">先生モード</h3>
                    <p class="text-xs text-slate-400 mt-1">リアルタイム対戦 & 課題(Assign)配信</p>
                </div>
            </button>

            <button onclick="switchRole('student')" class="group p-6 glass-panel rounded-2xl hover:border-emerald-500 transition duration-300 flex flex-col items-center gap-4 text-center hover:shadow-emerald-500/10 hover:shadow-2xl">
                <div class="w-16 h-16 rounded-2xl bg-emerald-600/20 text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition flex items-center justify-center text-2xl font-bold">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg text-white group-hover:text-emerald-400 transition">生徒モード</h3>
                    <p class="text-xs text-slate-400 mt-1">対戦コード入力して参加</p>
                </div>
            </button>
        </div>

        <div class="pt-6 border-t border-slate-800 text-xs text-slate-500 flex justify-around">
            <span><i class="fa-solid fa-bolt text-amber-400 mr-1"></i> P2P リアルタイム対戦</span>
            <span><i class="fa-solid fa-cloud-arrow-up text-indigo-400 mr-1"></i> 週末課題配信対応</span>
            <span><i class="fa-solid fa-file-csv text-blue-400 mr-1"></i> CSV問題読込対応</span>
        </div>
    </div>

    <!-- ==================== TEACHER SCREENS ==================== -->
    <div id="teacherContainer" class="w-full hidden space-y-6">
        
        <!-- TEACHER HOME -->
        <div id="teacherHomeScreen" class="space-y-6">
            <!-- Header panel with mode tabs -->
            <div class="glass-panel p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-black text-white">先生コントロールパネル</h2>
                    <p class="text-slate-400 text-sm mt-1">問題管理、リアルタイム対戦ロビー開設、課題(Assign)作成を行います。</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button onclick="showTeacherSection('create')" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition flex items-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> 問題手動作成
                    </button>
                    <button onclick="showTeacherSection('csv')" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition flex items-center gap-1.5">
                        <i class="fa-solid fa-file-csv"></i> CSVインポート
                    </button>
                </div>
            </div>

            <!-- QUESTION SET MANAGEMENT PANEL (NEW) -->
            <div class="glass-panel p-6 rounded-2xl space-y-4 border border-indigo-500/30">
                <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                    <h3 class="font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-folder-open text-amber-400"></i> 問題セット管理 (保存先: localStorage)
                    </h3>
                    <span class="text-xs text-slate-400">先生の端末に自動保存されます</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="space-y-2">
                        <label class="block text-slate-400 text-xs font-bold">作成中の問題セット名</label>
                        <input type="text" id="currentSetNameInput" value="Lesson 1" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white font-bold text-sm focus:outline-none focus:border-indigo-500" placeholder="例: Lesson 4 週末課題">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-slate-400 text-xs font-bold">保存済みセットを呼び出し</label>
                        <select id="savedQuestionSetsSelect" onchange="loadSelectedQuestionSet()" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white text-sm focus:outline-none">
                            <option value="">-- 保存セットを選択 --</option>
                        </select>
                    </div>
                    <div class="flex items-end gap-2">
                        <button onclick="saveCurrentQuestionSet()" class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-floppy-disk"></i> このセットを保存
                        </button>
                        <button onclick="deleteSelectedQuestionSet()" class="px-3 py-2.5 bg-slate-800 hover:bg-rose-900 text-rose-400 font-bold rounded-xl text-xs transition border border-slate-700">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- MAIN WORKSPACE: QUESTIONS BANK & MODES -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Left: Questions Bank -->
                <div class="md:col-span-2 glass-panel p-6 rounded-2xl space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                        <h3 class="font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-indigo-400"></i>
                            現在の問題バンク (<span id="questionCount">0</span>問)
                        </h3>
                        <button onclick="clearAllQuestions()" class="text-xs text-rose-400 hover:text-rose-300 font-medium">全消去</button>
                    </div>
                    
                    <div id="questionList" class="space-y-3 max-h-80 overflow-y-auto pr-2">
                        <div class="text-center py-8 text-slate-500 text-sm">
                            問題がまだ登録されていません。「問題を手動作成」または「CSVインポート」から追加してください。
                        </div>
                    </div>
                </div>

                <!-- Right: Execution Options (Live Game vs Assignment Assign) -->
                <div class="space-y-4">
                    <!-- Mode 1: Assign for Homework -->
                    <div class="glass-panel p-5 rounded-2xl space-y-3 border-2 border-indigo-500/50 bg-indigo-950/20">
                        <div class="flex items-center gap-2 text-indigo-400 font-bold text-sm border-b border-indigo-500/30 pb-2">
                            <i class="fa-solid fa-paper-plane text-lg"></i> 週末課題 / Assign 機能
                        </div>
                        <p class="text-xs text-slate-300">現在の問題をGitHub課題データ(JSON)として出力・配信します。</p>
                        <button onclick="showTeacherSection('assign')" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-calendar-plus"></i> 課題を作成 (Assign)
                        </button>
                    </div>

                    <!-- Mode 2: Realtime Live Match -->
                    <div class="glass-panel p-5 rounded-2xl space-y-3 border border-slate-700">
                        <div class="flex items-center gap-2 text-purple-400 font-bold text-sm border-b border-slate-700 pb-2">
                            <i class="fa-solid fa-users text-lg"></i> リアルタイム対戦
                        </div>
                        <div class="space-y-2 text-xs">
                            <div>
                                <label class="block text-slate-400 font-bold mb-1">チーム数</label>
                                <select id="teamCountSelect" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
                                    <option value="2">2 チーム</option>
                                    <option value="3">3 チーム</option>
                                    <option value="4" selected>4 チーム</option>
                                    <option value="5">5 チーム</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-slate-400 font-bold mb-1">チーム割り当て</label>
                                <select id="teamAssignmentSelect" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
                                    <option value="student">生徒が自由に選択</option>
                                    <option value="random">自動・ランダム振り分け</option>
                                </select>
                            </div>
                        </div>
                        <button onclick="startHostingGame()" class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold text-sm rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-play"></i> リアルタイム対戦を開設
                        </button>
                    </div>
                </div>
            </div>

            <!-- Past Results & Export Section -->
            <div class="glass-panel p-6 rounded-2xl space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-square-poll-vertical text-emerald-400"></i> 直近のゲーム成績ログ
                    </h3>
                    <button onclick="downloadResultsCSV()" id="downloadResultBtn" disabled class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-slate-300 text-xs font-bold rounded-lg transition border border-slate-700 flex items-center gap-1">
                        <i class="fa-solid fa-download"></i> 成績表CSVをダウンロード
                    </button>
                </div>
                <div id="pastResultsTable" class="overflow-x-auto text-xs text-slate-300">
                    <p class="text-slate-500 text-center py-4">まだ実施されたゲームの結果はありません。</p>
                </div>
            </div>
        </div>

        <!-- TEACHER ASSIGNMENT CREATION (ASSIGN) SCREEN -->
        <div id="teacherAssignScreen" class="hidden glass-panel p-6 rounded-2xl space-y-6 max-w-2xl mx-auto">
            <div class="flex justify-between items-center border-b border-slate-700 pb-4">
                <h3 class="font-bold text-lg text-white flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane text-indigo-400"></i> 課題の作成 & 配信設定 (Assign)
                </h3>
                <button onclick="showTeacherSection('home')" class="text-xs text-slate-400 hover:text-white">戻る</button>
            </div>

            <div class="space-y-4 text-sm">
                <div class="bg-indigo-950/40 border border-indigo-500/30 rounded-2xl p-4 space-y-1 text-xs">
                    <p class="font-bold text-indigo-300"><i class="fa-solid fa-circle-info mr-1"></i> 配信のながれ</p>
                    <p class="text-slate-300">1. 下記で課題名と提出期限を設定し「課題JSONを作成・ダウンロード」を押します。</p>
                    <p class="text-slate-300">2. 生成されたJSONファイルをGitHubリポジトリの <code class="font-mono text-amber-300">assignments/</code> フォルダにアップロードします。</p>
                    <p class="text-slate-300">3. 生成されたGoogle Classroom用URLを生徒に配布します。</p>
                </div>

                <div>
                    <label class="block text-slate-400 text-xs font-bold mb-1">対象問題セット</label>
                    <div id="assignSetNameDisplay" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-emerald-400 font-bold">
                        Lesson 1 (全 3 問)
                    </div>
                </div>

                <div>
                    <label class="block text-slate-400 text-xs font-bold mb-1">課題タイトル</label>
                    <input type="text" id="assignTitleInput" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white font-bold" placeholder="例: Lesson 4 Weekend Homework">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-slate-400 text-xs font-bold mb-1">開始日時 (startDate)</label>
                        <input type="datetime-local" id="assignStartDate" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-xs font-bold mb-1">提出締切日時 (dueDate)</label>
                        <input type="datetime-local" id="assignDueDate" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white">
                    </div>
                </div>

                <button onclick="generateAndDownloadAssignmentJSON()" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-arrow-down"></i> 課題JSONを作成 & ダウンロード
                </button>

                <!-- GitHub URL Assembly Section -->
                <div id="githubUrlConfigBox" class="hidden pt-4 border-t border-slate-700 space-y-4">
                    <div class="bg-emerald-950/30 border border-emerald-500/30 rounded-2xl p-4 text-xs space-y-2">
                        <p class="font-bold text-emerald-400"><i class="fa-solid fa-circle-check mr-1"></i> 課題JSONをダウンロードしました！</p>
                        <p class="text-slate-300">GitHubの <code class="font-mono text-amber-300">assignments</code> フォルダにこのファイルをアップロードしてください。</p>
                    </div>

                    <h4 class="font-bold text-white text-xs">Google Classroom用URL作成設定</h4>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <label class="block text-slate-400 font-bold mb-1">GitHubユーザー名</label>
                            <input type="text" id="ghUsernameInput" oninput="updateGeneratedClassroomUrl()" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-mono" placeholder="your-username">
                        </div>
                        <div>
                            <label class="block text-slate-400 font-bold mb-1">リポジトリ名</label>
                            <input type="text" id="ghRepoInput" oninput="updateGeneratedClassroomUrl()" value="English-Battle" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-mono">
                        </div>
                    </div>

                    <div>
                        <label class="block text-slate-400 text-xs font-bold mb-1">生成された生徒用URL (Classroom添付用)</label>
                        <input type="text" id="generatedStudentUrlDisplay" readonly class="w-full bg-slate-900 border border-indigo-500/50 rounded-xl p-3 text-indigo-300 font-mono text-xs select-all">
                    </div>

                    <div class="flex gap-2">
                        <button onclick="copyGeneratedStudentUrl()" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-copy"></i> URLをコピー
                        </button>
                        <button onclick="testVerifyAssignmentUrl()" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl text-xs transition border border-slate-700 flex items-center gap-1.5">
                            <i class="fa-solid fa-magnifying-glass"></i> 課題URLを確認
                        </button>
                    </div>
                    <p id="urlVerificationStatus" class="text-xs font-mono text-center"></p>
                </div>
            </div>
        </div>

        <!-- MANUAL QUESTION CREATOR -->
        <div id="teacherCreateScreen" class="hidden glass-panel p-6 rounded-2xl space-y-6 max-w-2xl mx-auto">
            <div class="flex justify-between items-center border-b border-slate-700 pb-4">
                <h3 class="font-bold text-lg text-white flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-indigo-400"></i> 問題の新規作成
                </h3>
                <button onclick="showTeacherSection('home')" class="text-xs text-slate-400 hover:text-white">戻る</button>
            </div>

            <form id="questionForm" onsubmit="handleManualQuestionSubmit(event)" class="space-y-4 text-sm">
                <div>
                    <label class="block text-slate-400 text-xs font-bold mb-1">問題形式</label>
                    <select id="qType" onchange="toggleFormByQType()" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white">
                        <option value="choice">4択問題</option>
                        <option value="reorder">並べ替え問題 (英語語句)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-slate-400 text-xs font-bold mb-1" id="qLabel">問題文 (日本語または英語)</label>
                    <textarea id="qQuestion" required rows="2" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white placeholder-slate-500" placeholder="例: I have lived in Tokyo ___ 2018."></textarea>
                </div>

                <!-- 4-Choice Specific Fields -->
                <div id="choiceFields" class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">選択肢 A</label>
                            <input type="text" id="choiceA" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2 text-white">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">選択肢 B</label>
                            <input type="text" id="choiceB" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2 text-white">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">選択肢 C</label>
                            <input type="text" id="choiceC" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2 text-white">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">選択肢 D</label>
                            <input type="text" id="choiceD" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2 text-white">
                        </div>
                    </div>

                    <div>
                        <label class="block text-slate-400 text-xs font-bold mb-1">正解選択肢</label>
                        <select id="correctChoice" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>
                </div>

                <!-- Reorder Specific Fields -->
                <div id="reorderFields" class="hidden space-y-3">
                    <div>
                        <label class="block text-slate-400 text-xs font-bold mb-1">正解英文 (スペース区切りまたは / 区切り)</label>
                        <input type="text" id="reorderAnswer" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white placeholder-slate-500" placeholder="I / studied / English / yesterday.">
