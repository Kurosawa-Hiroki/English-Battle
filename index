    // --- IMPROVED REORDER QUESTION ENGINE (STRICT STEPWISE INTERACTION) ---
    function setupImprovedReorderSystem(answerString) {
        // Split target words by '/' or spaces
        const tokens = answerString.includes('/')
            ? answerString.split('/').map(s => s.trim()).filter(Boolean)
            : answerString.split(' ').map(s => s.trim()).filter(Boolean);

        reorderTargetWords = [...tokens];
        currentPlacedCards = [];

        // Prepare option cards with unique IDs
        currentShuffledCards = tokens.map((w, idx) => ({
            id: `card_${idx}_${Math.random().toString(36).substr(2, 4)}`,
            word: w
        }));

        // Shuffle option cards
        for (let i = currentShuffledCards.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [currentShuffledCards[i], currentShuffledCards[j]] = [currentShuffledCards[j], currentShuffledCards[i]];
        }

        document.getElementById('reorderFeedbackText').innerText = '';
        renderImprovedReorderUI();
    }

    function renderImprovedReorderUI() {
        const answerBox = document.getElementById('reorderAnswerArea');
        const optionsBox = document.getElementById('reorderOptionsArea');

        // Render Fixed Placed Cards
        answerBox.innerHTML = currentPlacedCards.map(c => `
            <div class="px-3 py-2 bg-emerald-600 text-white font-bold text-sm rounded-xl shadow border border-emerald-400/30 flex items-center gap-1">
                <i class="fa-solid fa-lock text-[10px] text-emerald-200"></i>
                <span>${c.word}</span>
            </div>
        `).join('') || '<span class="text-xs text-slate-500 italic p-2">下の英単語を正しい順番でタップしてください</span>';

        // Render Available Source Cards
        optionsBox.innerHTML = currentShuffledCards.map(c => `
            <button id="opt_${c.id}" onclick="handleReorderWordTap('${c.id}')" class="word-card px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm rounded-xl border border-slate-700 shadow transition">
                ${c.word}
            </button>
        `).join('');
    }

    function handleReorderWordTap(cardId) {
        const cardIdx = currentShuffledCards.findIndex(c => c.id === cardId);
        if (cardIdx < 0) return;

        const tappedCard = currentShuffledCards[cardIdx];
        const nextExpectedIndex = currentPlacedCards.length;
        const expectedWord = reorderTargetWords[nextExpectedIndex];

        // Normalize comparison for case/punctuation tolerance
        const normalize = s => s.replace(/[\/\,\.]/g, '').trim().toLowerCase();

        if (normalize(tappedCard.word) === normalize(expectedWord)) {
            // CORRECT TAP: Lock word in place
            soundSystem.play('click');
            currentPlacedCards.push(tappedCard);
            currentShuffledCards.splice(cardIdx, 1);
            document.getElementById('reorderFeedbackText').innerText = '';
            renderImprovedReorderUI();

            // Check if sentence complete
            if (currentPlacedCards.length === reorderTargetWords.length) {
                soundSystem.play('correct');
                const fullSentence = currentPlacedCards.map(c => c.word).join(' ');
                
                if (isAssignmentMode) {
                    setTimeout(() => handleAssignmentAnswer(true, fullSentence), 400);
                } else if (studentConnection) {
                    studentConnection.send({
                        action: 'submit_answer',
                        reorderString: fullSentence,
                        remainingTime: timerSeconds
                    });
                    showStudentSection('submitted');
                }
            }
        } else {
            // INCORRECT TAP: Play shake animation & error sound, do NOT place
            soundSystem.play('incorrect');
            const btn = document.getElementById(`opt_${cardId}`);
            const feedback = document.getElementById('reorderFeedbackText');
            if (feedback) feedback.innerText = '× 順番が違います';

            if (btn) {
                btn.classList.add('shake-error');
                setTimeout(() => {
                    btn.classList.remove('shake-error');
                }, 350);
            }
        }
    }

    function resetReorderWords() {
        soundSystem.play('click');
        if (reorderTargetWords.length > 0) {
            setupImprovedReorderSystem(reorderTargetWords.join(' / '));
        }
    }

