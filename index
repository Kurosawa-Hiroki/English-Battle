    function handleCSVUpload(event) {
        const file = event.target.files[0];
        if (!file) return;

        Papa.parse(file, {
            header: true,
            skipEmptyLines: true,
            complete: function(results) {
                let count = 0;
                let skipped = 0;
                results.data.forEach(row => {
                    const type = (row.question_type||'').trim().toLowerCase();
                    if(!type && !row.question && !row.japanese && !row.answer) return;
                    if(type === 'reorder'){
                        const japanese = (row.japanese||'').trim(), answer = (row.answer||'').trim();
                        if(japanese && answer){ 
                            questionsBank.push({
                                id: 'q_' + Date.now() + '_' + Math.floor(Math.random()*1000),
                                type: 'reorder', japanese, answer, time: parseInt(row.time)||45, explanation: row.explanation||''
                            }); 
                            count++; 
                        } else skipped++;
                    } else if(type === 'choice' || (!type && row.question)){
                        const question = (row.question||'').trim(), a = (row.choiceA||'').trim(), b = (row.choiceB||'').trim(), c = (row.choiceC||'').trim(), d = (row.choiceD||'').trim();
                        const ansChar = (row.answer||'').trim().toUpperCase();
                        const choiceMap = { 'A': a, 'B': b, 'C': c, 'D': d };
                        const targetAns = choiceMap[ansChar] || (ansChar ? row.answer : a);

                        if(question && a && b){ 
                            questionsBank.push({
                                id: 'q_' + Date.now() + '_' + Math.floor(Math.random()*1000),
                                type: 'choice', question, choiceA: a, choiceB: b, choiceC: c, choiceD: d,
                                choices: [a, b, c, d], answer: targetAns, time: parseInt(row.time)||20, explanation: row.explanation||''
                            }); 
                            count++; 
                        } else skipped++;
                    } else skipped++;
                });

                alert(`${count}件の問題を読み込みました！${skipped ? `\n（${skipped}行はスキップしました）` : ''}`);
                showTeacherSection('home');
                renderQuestionsList();
            }
        });
    }

