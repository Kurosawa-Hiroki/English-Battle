<script>
    // Web Audio API Sound Generator
    class SoundSystem {
        constructor() {
            this.enabled = true;
            this.ctx = null;
            this.master = null;
            this.bgmGain = null;
            this.bgmTimer = null;
            this.bgmStep = 0;
            this.bgmRunning = false;
        }

        init() {
            if (!this.ctx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) {
                    this.ctx = new AudioContext();
                    this.master = this.ctx.createGain();
                    this.master.gain.value = 0.75;
                    this.master.connect(this.ctx.destination);
                    this.bgmGain = this.ctx.createGain();
                    this.bgmGain.gain.value = 0.0;
                    this.bgmGain.connect(this.master);
                }
            }
            if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
        }

        setEnabled(value) {
            this.enabled = value;
            if (!value) this.stopBgm();
        }

        tone(freq, duration=0.12, type='sine', volume=0.12, when=null, target=null) {
            if (!this.enabled) return;
            this.init();
            if (!this.ctx) return;
            const ctx = this.ctx;
            const t = when ?? ctx.currentTime;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, t);
            gain.gain.setValueAtTime(Math.max(0.001, volume), t);
            gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
            osc.connect(gain);
            gain.connect(target || this.master);
            osc.start(t);
            osc.stop(t + duration + 0.02);
        }

        play(type) {
            if (!this.enabled) return;
            this.init();
            if (!this.ctx) return;
            const ctx = this.ctx;
            const now = ctx.currentTime;

            if (type === 'click') {
                this.tone(720, 0.055, 'sine', 0.12, now);
            } else if (type === 'correct') {
                [523.25, 659.25, 783.99, 1046.50].forEach((f,i) => this.tone(f, 0.22, 'triangle', 0.18, now+i*0.07));
            } else if (type === 'incorrect') {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type='sawtooth';
                osc.frequency.setValueAtTime(240, now);
                osc.frequency.exponentialRampToValueAtTime(120, now+0.28);
                gain.gain.setValueAtTime(0.12, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now+0.28);
                osc.connect(gain); gain.connect(this.master); osc.start(now); osc.stop(now+0.3);
            } else if (type === 'start') {
                [392,523.25,659.25,783.99].forEach((f,i) => this.tone(f,0.24,'triangle',0.16,now+i*0.09));
            } else if (type === 'countdown') {
                this.tone(880,0.08,'square',0.09,now);
            } else if (type === 'timeup') {
                [659.25,523.25,392].forEach((f,i) => this.tone(f,0.18,'square',0.15,now+i*0.12));
            } else if (type === 'score') {
                [784,988,1174].forEach((f,i) => this.tone(f,0.18,'triangle',0.14,now+i*0.07));
            } else if (type === 'leaderboard') {
                [392,440,523,659].forEach((f,i) => this.tone(f,0.22,'sine',0.13,now+i*0.11));
            } else if (type === 'win') {
                [523.25,659.25,783.99,1046.50,1318.51,1567.98].forEach((f,i) => this.tone(f,0.34,'triangle',0.18,now+i*0.11));
            }
        }

        startBgm() {
            if (!this.enabled || this.bgmRunning) return;
            this.init();
            if (!this.ctx || !this.bgmGain) return;
            this.stopBgm();
            this.bgmRunning = true;
            this.bgmStep = 0;
            this.bgmGain.gain.cancelScheduledValues(this.ctx.currentTime);
            this.bgmGain.gain.setValueAtTime(0.0, this.ctx.currentTime);
            this.bgmGain.gain.linearRampToValueAtTime(0.055, this.ctx.currentTime + 0.8);

            const pattern = [261.63,329.63,392.00,329.63,293.66,349.23,440.00,349.23];
            const tick = () => {
                if (!this.bgmRunning || !this.enabled) return;
                const f = pattern[this.bgmStep % pattern.length];
                this.tone(f,0.28,'triangle',0.10,this.ctx.currentTime,this.bgmGain);
                if (this.bgmStep % 2 === 0) this.tone(f/2,0.42,'sine',0.045,this.ctx.currentTime,this.bgmGain);
                this.bgmStep++;
                this.bgmTimer = setTimeout(tick, 360);
            };
            tick();
        }

        stopBgm() {
            if (this.bgmTimer) clearTimeout(this.bgmTimer);
            this.bgmTimer = null;
            this.bgmRunning = false;
            if (this.bgmGain && this.ctx) {
                const t=this.ctx.currentTime;
                this.bgmGain.gain.cancelScheduledValues(t);
                this.bgmGain.gain.setTargetAtTime(0.0,t,0.12);
            }
        }
    }

    const soundSystem = new SoundSystem();

    function toggleSound() {
        soundSystem.setEnabled(!soundSystem.enabled);
        const icon = document.getElementById('soundIcon');
        if (soundSystem.enabled) {
            soundSystem.init();
            icon.className = 'fa-solid fa-volume-high';
            soundSystem.play('click');
        } else {
            icon.className = 'fa-solid fa-volume-xmark text-rose-400';
        }
    }
</script>

