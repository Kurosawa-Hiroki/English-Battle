    function handleStudentMessage(conn, data) {
        if (data.action === 'join') {
            let assignedTeam = data.team;

            if (activeConfig.teamAssignment === 'random') {
                const activeTeams = TEAMS.slice(0, activeConfig.teamCount);
                const counts = activeTeams.map(t => ({ id: t.id, count: studentsList.filter(s => s.team === t.id).length }));
                counts.sort((a,b) => a.count - b.count);
                assignedTeam = counts[0].id;
            }

            const newStudent = {
                id: conn.peer, peerId: conn.peer, nickname: data.nickname || 'Student',
                team: assignedTeam, score: 0, streak: 0, correctCount: 0, incorrectCount: 0
            };

            const existingIdx = studentsList.findIndex(s => s.peerId === conn.peer);
            if (existingIdx >= 0) studentsList[existingIdx] = newStudent;
            else studentsList.push(newStudent);

            conn.send({ action: 'join_ack', team: assignedTeam, config: activeConfig });
            renderTeacherLobbyTeams();
