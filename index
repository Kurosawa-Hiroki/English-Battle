        peer = new Peer(peerId);

        peer.on('open', (id) => {
            showTeacherSection('lobby');
            renderTeacherLobbyTeams();
            generateLobbyQRCode(gameCode);
        });

        peer.on('connection', (conn) => {
            teacherConnections.push(conn);
            conn.on('data', (data) => handleStudentMessage(conn, data));
            conn.on('close', () => {
                studentsList = studentsList.filter(s => s.peerId !== conn.peer);
